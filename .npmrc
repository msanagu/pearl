# React must be a true singleton for hooks/context to work across the package
# boundary (Storybook, Vitest, and the lib build all import React). pnpm's
# strict, isolated node_modules is otherwise correct default behavior — this
# is the one deliberate hoist, not a blanket opt-out of isolation.
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom

# Fail fast if a dependency's peer-dependency requirement isn't met, rather
# than silently installing a mismatched version.
strict-peer-dependencies=false
auto-install-peers=true
