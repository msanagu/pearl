{
  "name": "@msanagu/pearl",
  "version": "0.3.2",
  "description": "A small, intentional, composition-first React design system styled with vanilla-extract.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/msanagu/pearl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./manifest/base.json": "./dist/manifest/base.json",
    "./manifest/pearl.json": "./dist/manifest/pearl.json",
    "./manifest/tahitian.json": "./dist/manifest/tahitian.json",
    "./manifest/freshwater.json": "./dist/manifest/freshwater.json",
    "./manifest/south-sea.json": "./dist/manifest/south-sea.json",
    "./components/*": "./dist/components/*",
    "./llms.txt": "./dist/llms.txt"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/rewrite-dts-aliases.mjs && node scripts/generate-manifest.mjs && node scripts/generate-llms-txt.mjs",
    "prepare": "pnpm build",
    "generate:manifest": "node scripts/generate-manifest.mjs && node scripts/generate-llms-txt.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p \"${PORT:-6006}\"",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/private": "^1.0.9",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.6.3",
    "csstype": "3.2.3",
    "esbuild": "^0.28.2",
    "impeccable": "^3.3.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "react-docgen": "^8.0.3",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
