{
  // Declaration-emit pass for the published package. Runs after `vite build`
  // (which produces the JS/CSS bundle); this emits only .d.ts files into dist/.
  // Zero extra build dependencies — plain tsc, per the dependency-light ethos.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "src/test",
    "src/foundations",
    // Build-time validation only (ADR-0010) — never part of the public API.
    "src/validate",
    // Storybook-only internals (docs landing page, treatment demos) and page
    // templates — neither is re-exported from src/index.ts, so emitting
    // declarations for them just ships dead .d.ts files to consumers.
    "src/introduction",
    "src/templates",
    // Build-time manifest generator input only (consumed by scripts/generate-manifest.mjs);
    // not re-exported from src/index.ts and not part of the package's exports map.
    "src/manifest"
  ]
}
