{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Strictness — "strict mode on" per the docs. See docs open-question #8
       for exactOptionalPropertyTypes (deliberately left off for now). */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Module hygiene */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* This is a checked-only config; Vite emits JS, tsc only type-checks. */
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "experiments", ".storybook", "vite.config.ts", "vitest.config.ts"]
}
